              "raw": "{\n  \"name\": \"agentBuilder_agentworkflow\",\n  \"schema\": \"public\",\n  \"columns\": [\n    \"id\",\n    \"name\",\n    \"display_name\"\n  ],\n  \"filters\": [\n    {\n      \"column\": \"name\",\n      \"op\": \"ilike\",\n      \"value\": \"%agent%\"\n    }\n  ],\n  \"order_by\": [\n    {\n      \"column\": \"name\"\n    }\n  ],\n  \"limit\": 100\n}",
