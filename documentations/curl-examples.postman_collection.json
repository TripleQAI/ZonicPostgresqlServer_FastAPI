        {
          "name": "Subscribe — GET /v1/datasources/{name}/subscribe/{channel}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/datasources/{{datasource}}/subscribe/orders_changed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "datasources",
                "{{datasource}}",
                "subscribe",
                "orders_changed"
              ]
            },
            "description": "LISTEN/NOTIFY over SSE. Unbounded lifetime — pins a connection for as long as the client stays connected."
          }
        }
      ]
    },
