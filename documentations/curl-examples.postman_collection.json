            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"name\": \"agentBuilder_agentworkflow\",\n  \"schema\": \"agent_builder\",\n  \"limit\": 10\n}"
            },
            "description": "Confirmed working against pgfoundation.dev.tripleq.ai (datasource=tsdb, table agent_builder.agentBuilder_agentworkflow). Valid filters[].op values: eq ne lt le gt ge in not_in like ilike between is_null is_not_null"
