    {
      "name": "5. Batch — POST /v1/batch",
      "item": [
        {
          "name": "Parallel — scatter-gather across data sources",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "batch"
              ]
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"mode\": \"parallel\",\n  \"max_concurrency\": 8,\n  \"fail_fast\": false,\n  \"items\": [\n    {\"id\": \"orders\", \"datasource\": \"main\", \"op\": \"view\",\n     \"payload\": {\"name\": \"v_paid_orders\"}},\n    {\"id\": \"daily\", \"datasource\": \"analytics\", \"op\": \"function\",\n     \"payload\": {\"name\": \"fn_daily_totals\", \"args\": {\"day\": \"2026-08-13\"}}}\n  ]\n}"
            },
            "description": "HTTP stays 200 on partial failure — each item carries its own status."
          }
        },
        {
          "name": "Sequential — one pinned connection, pipelined",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "batch"
              ]
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"mode\": \"sequential\",\n  \"items\": [\n    {\"id\": \"1\", \"datasource\": \"main\", \"op\": \"view\", \"payload\": {\"name\": \"v_paid_orders\", \"limit\": 1}},\n    {\"id\": \"2\", \"datasource\": \"main\", \"op\": \"view\", \"payload\": {\"name\": \"v_paid_orders\", \"limit\": 2}}\n  ]\n}"
            }
          }
        },
        {
          "name": "Transactional — all-or-nothing UnitOfWork",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "batch"
              ]
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"mode\": \"transactional\",\n  \"items\": [\n    {\"id\": \"1\", \"datasource\": \"main\", \"op\": \"procedure\",\n     \"payload\": {\"name\": \"sp_debit\", \"args\": [\"acct-1\", 100]}},\n    {\"id\": \"2\", \"datasource\": \"main\", \"op\": \"procedure\",\n     \"payload\": {\"name\": \"sp_credit\", \"args\": [\"acct-2\", 100]}}\n  ]\n}"
            },
            "description": "Retried whole on serialization failure (40001/40P01) — items must have no non-database side effects."
          }
        }
      ]
