    {
      "name": "6 \u00b7 Guarantees (expected failures)",
      "description": "These are *supposed* to fail. They demonstrate the security and validation boundaries.",
      "item": [
        {
          "name": "400 \u2014 SQL injection in an object name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
