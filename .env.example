# Copy to `.env` (gitignored) and fill in. The VS Code launch configurations load
# this file, so credentials stay out of the repository — the same rule production
# follows: the config file names the source, the environment supplies the secret
# (documentations/12-deployment-targets.md §12.2).

# The data source referenced by config/pgfoundation.yaml as ${env:PGF_MAIN_DSN}.
PGF_MAIN_DSN=postgresql://user:password@localhost:5432/postgres

# The Timescale Cloud target. Prefer sslmode=verify-full over require: `require`
# encrypts but does NOT authenticate the server, so it does not defend against an
# active man-in-the-middle over the public internet (doc 12 §12.3).
# PGF_MAIN_DSN=postgresql://ROLE:PASSWORD@aqy26lurzx.lhy6ly0as0.tsdb.cloud.timescale.com:32064/tsdb?sslmode=verify-full&application_name=pgfoundation

# Optional: enables the 4 live-PostgreSQL integration tests, which skip without it.
# PGF_TEST_DSN=postgresql://user:password@localhost:5432/postgres
