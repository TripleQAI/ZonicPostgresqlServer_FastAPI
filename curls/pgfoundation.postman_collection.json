    {
      "name": "2 \u00b7 Batch",
      "description": "N operations in one request, with the execution semantics chosen per request.",
      "item": [
        {
          "name": "parallel \u2014 fan out across data sources",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "x-client-cert-subject",
                "value": "{{callerSubject}}",
                "disabled": true
              },
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "batch"
              ]
            },
            "description": "The default. Independent operations run concurrently against independent pools. Partial success is normal: HTTP stays 200 and each item carries its own `status`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"parallel\",\n  \"max_concurrency\": 8,\n  \"items\": [\n    {\n      \"id\": \"orders\",\n      \"datasource\": \"{{datasource}}\",\n      \"op\": \"view\",\n      \"payload\": {\n        \"name\": \"agentBuilder_agentworkflow\",\n        \"schema\": \"public\",\n        \"limit\": 50\n      }\n    },\n    {\n      \"id\": \"totals\",\n      \"datasource\": \"{{datasource}}\",\n      \"op\": \"function\",\n      \"payload\": {\n        \"name\": \"now\",\n        \"scalar\": true\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "sequential \u2014 ordered, pipelined",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "x-client-cert-subject",
                "value": "{{callerSubject}}",
                "disabled": true
              },
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "batch"
              ]
            },
            "description": "One pinned connection, statements pipelined. Order is guaranteed and the HTTP/validation cost is paid once. Not atomic \u2014 use `transactional` for all-or-nothing. All items must target the same data source.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"sequential\",\n  \"items\": [\n    {\n      \"id\": \"s0\",\n      \"datasource\": \"{{datasource}}\",\n      \"op\": \"view\",\n      \"payload\": {\n        \"name\": \"django_migrations\",\n        \"schema\": \"public\",\n        \"limit\": 10\n      }\n    },\n    {\n      \"id\": \"s1\",\n      \"datasource\": \"{{datasource}}\",\n      \"op\": \"view\",\n      \"payload\": {\n        \"name\": \"django_migrations\",\n        \"schema\": \"public\",\n        \"limit\": 10\n      }\n    },\n    {\n      \"id\": \"s2\",\n      \"datasource\": \"{{datasource}}\",\n      \"op\": \"view\",\n      \"payload\": {\n        \"name\": \"django_migrations\",\n        \"schema\": \"public\",\n        \"limit\": 10\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "transactional \u2014 all or nothing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "x-client-cert-subject",
                "value": "{{callerSubject}}",
                "disabled": true
              },
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "batch"
              ]
            },
            "description": "One UnitOfWork for every item, retried **whole** on serialization failure (40001) or deadlock (40P01).\n\n**The body may run more than once**, so items must be free of non-database side effects. All items must target the same data source.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"transactional\",\n  \"items\": [\n    {\n      \"id\": \"insert\",\n      \"datasource\": \"{{datasource}}\",\n      \"op\": \"execute\",\n      \"payload\": {\n        \"sql\": \"INSERT INTO pgf_demo_orders (id, customer, amount, status) VALUES (%(id)s, 'grace', '10.00', 'paid')\",\n        \"params\": {\n          \"id\": 301\n        }\n      }\n    },\n    {\n      \"id\": \"update\",\n      \"datasource\": \"{{datasource}}\",\n      \"op\": \"execute\",\n      \"payload\": {\n        \"sql\": \"UPDATE pgf_demo_orders SET status = 'shipped' WHERE id = %(id)s\",\n        \"params\": {\n          \"id\": 301\n        }\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
