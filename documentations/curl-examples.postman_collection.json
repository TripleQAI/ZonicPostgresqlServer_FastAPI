              "raw": "{\n  \"name\": \"readings\",\n  \"filters\": [{\"column\": \"day\", \"op\": \"eq\", \"value\": \"2026-08-13\"}],\n  \"row_format\": \"tuple\"\n}"
            },
            "description": "NDJSON by default, or SSE with Accept: text/event-stream. Use instead of /view whenever the result may exceed api.max_response_rows."
