  "item": [
    {
      "name": "1. Operational endpoints (unversioned)",
      "item": [
        {
          "name": "Liveness — GET /health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "200 while the process is up. Does NOT touch the database."
          }
        },
        {
          "name": "Readiness — GET /ready",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            },
            "description": "Runs SELECT 1 per datasource. Returns 503 when every source is down."
          }
        },
        {
          "name": "Prometheus scrape — GET /metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metrics"
              ]
            },
            "description": "Empty body until an exporter is bound."
          }
        }
      ]
    },
