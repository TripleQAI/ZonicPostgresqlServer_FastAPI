              ],
              "path": [
                "v1",
                "datasources",
                "{{datasource}}",
                "view"
              ]
            },
            "description": "The identifier is validated, never interpolated. This is the security boundary the whole name-based surface rests on.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"agentBuilder_agentworkflow; DROP TABLE auth_user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
