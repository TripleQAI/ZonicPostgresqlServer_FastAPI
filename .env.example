# Copy to `.env` (gitignored) and fill in. The VS Code launch configurations load
# this file, so credentials stay out of the repository — the same rule production
# follows: the config file names the source, the environment supplies the secret
# (documentations/12-deployment-targets.md §12.2).

# The data source referenced by config/pgfoundation.yaml as ${secret:PGF_TSDB_DSN}.
# Timescale Cloud (AWS) — fill in <PASSWORD>:
PGF_TSDB_DSN=postgresql://tsdbadmin:<PASSWORD>@aqy26lurzx.lhy6ly0as0.tsdb.cloud.timescale.com:32064/tsdb?sslmode=verify-full&application_name=pgfoundation

# Or a local PostgreSQL:
# PGF_TSDB_DSN=postgresql://user:password@localhost:5432/postgres
#
# The Tiger Cloud service is paused (2026-11). The process still needs a value
# here to start; an unreachable one just reports tsdb as down.

# The data pipeline's Config database, referenced as ${secret:PGF_ZDP_CONFIG_DSN}.
# Neon project `zonic-data-pipeline`. Use the DIRECT host from the Neon Console
# (no `-pooler`) and the `pgfoundation_zdp_config` role, never the owner:
PGF_ZDP_CONFIG_DSN=postgresql://pgfoundation_zdp_config:<PASSWORD>@ep-noisy-wildflower-bbwrluey.c-15.us-east-1.aws.neon.tech:5432/zdp_config?sslmode=require&channel_binding=require&application_name=pgfoundation


# Optional: enables the 4 live-PostgreSQL integration tests, which skip without it.
# PGF_TEST_DSN=postgresql://user:password@localhost:5432/postgres
